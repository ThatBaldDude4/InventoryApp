<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Categories</h1>
    <!-- Need to create and properly wire categories-->
    <% if (locals.rows) { %>
        <% rows.forEach(data => { %>
            <a href="<%= `/home?category=${data?.category}` %>" ><%= data?.category %></a>    
        <% }) %>
    <% }; %>
</body>
</html>