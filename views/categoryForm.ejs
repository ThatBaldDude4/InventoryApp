<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Category Page</title>
</head>
<body>
    <form method="POST" action="/home/category/new">
        <h2>Add Category</h2>
        <label>
            <% if (locals?.error) { %>
                <ul>
                    <li><%= error %></li>
                </ul>    
            <% }; %>
            <input name="category" type="text" id="category" value="<%= locals?.rows?.category || '' %>">
        </label>
        <button type="submit">Add</button>
    </form>
</body>
</html>