<form method="POST" action="/home/category/edit">
    <% if (locals.rows) { %>
        <h2>Edit Category</h2>
        <select name="category">
            <option value="">Select Category</option>
        <% rows.forEach(data => { %>
            <option value="<%= data?.category %>" ><%= data?.category %></option>    
        <% }) %>
        </select>
        <label>
            New Name:
            <input name="updated_category_input">
        </label>
        <label>
            Password:
            <input name="password" class="password">
        </label>
        <button type="submit">Submit</button>
    <% }; %>
</form>