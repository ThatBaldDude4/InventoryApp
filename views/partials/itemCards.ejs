<% if (locals.rows) { %>
    <div id="all-item-container">
    <% rows.forEach(data => { %>
        <div class="item-container">
            <div class="skew-container">
                <img alt="product" />
                <div>
                    <h2><%= data?.item %></h2>
                    <p><%= data?.price %></p>
                    <p><%= data?.description %></p>
                    <a href="/products/<%= data?.id %>" class="button-style">Open</a>
                    <form method="POST" action="/products/<%= data?.id %>/delete">
                        <label>
                            Delete Password:
                            <input name="password">
                        </label>
                        <button class="button-style" type="submit">DELETE ITEM</button>
                    </form>
                </div>
            </div>
        </div>
    <% }) %>
    </div>
    <% if (locals.rows.length === 0) { %>
    <div>
        <h1>No Data Found</h1>
    </div>    
<% }; %>
<% }; %>